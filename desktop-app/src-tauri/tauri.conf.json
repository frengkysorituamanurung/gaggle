{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gaggle",
  "version": "0.1.0",
  "identifier": "com.gaggle.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:4321"
  },
  "app": {
    "windows": [
      {
        "title": "Gaggle",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}